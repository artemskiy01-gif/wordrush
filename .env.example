# Local development works without this file; data is saved in .data/postgres.
# For production, configure these in the hosting provider's secret settings:
# NODE_ENV=production
# APP_URL=https://your-service.onrender.com
# DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full
# SESSION_SECRET=generate-at-least-32-random-characters
# The hosting provider normally supplies PORT.
PORT=3000
# Optional local-only database location:
# LOCAL_DATABASE_DIR=.data/postgres
